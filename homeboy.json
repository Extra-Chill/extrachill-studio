{
  "id": "extrachill-studio",
  "changelog_target": "docs/CHANGELOG.md",
  "validation_dependencies": ["data-machine", "extrachill-analytics"],
  "extensions": {
    "wordpress": {}
  },
  "version_targets": [
    {
      "file": "extrachill-studio.php",
      "pattern": "Version:\\s*([\\d.]+)"
    },
    {
      "file": "extrachill-studio.php",
      "pattern": "EXTRACHILL_STUDIO_VERSION',\\s*'([\\d.]+)"
	},
	{
	  "file": "src/blocks/studio/block.json",
	  "pattern": "\"version\":\\s*\"([0-9.]+)\""
    }
  ]
}
